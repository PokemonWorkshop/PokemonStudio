{
  "compilerOptions": {
    "target": "es2024",
    "allowJs": true,
    "strict": true,
    "module": "esnext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "*": ["node_modules/*"],
      "@components/*": ["src/views/components/*"],
      "@ds/*": ["src/designSystem/*"],
      "@pages/*": ["src/views/pages/*"],
      "@modelEntities/*": ["src/models/entities/*"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"],
      "@hooks/*": ["src/hooks/*"],
      "@poc/*": ["src/poc/*"],
      "@src/*": ["src/*"],
      "@assets/*": ["assets/*"],
      "@root/*": ["*"]
    }
  },
  "include": ["src/**/*", "*.d.ts", "forge.config.ts", "updater_i18n.js", "eslint.config.mjs", "config/vite.alias.config.ts"]
}
