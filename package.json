{
  "name": "pokemon-studio",
  "productName": "Pokémon Studio",
  "description": "Pokémon Studio is a monster taming game editor which helps you to bring your ideas to life, in just a few clicks.",
  "version": "2.10.0",
  "main": "./.vite/build/index.js",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Pokémon Workshop",
    "email": "hostmaster@pokemonworkshop.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PokemonWorkshop/PokemonStudio.git"
  },
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=20.9.0"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": ">=10.9.0"
    }
  },
  "languages": {
    "en": {
      "suffix": "English, US",
      "active": true
    },
    "fr": {
      "suffix": "Français, FR",
      "active": true
    },
    "es": {
      "suffix": "Español",
      "active": true
    },
    "it": {
      "suffix": "Italiano",
      "active": true
    },
    "de": {
      "suffix": "Deutsch",
      "active": true
    },
    "pt": {
      "suffix": "Português",
      "active": true
    },
    "nl": {
      "suffix": "Nederlands",
      "active": true
    },
    "zh_Hans": {
      "suffix": "Chinese Simplified, 简体中文",
      "active": false
    },
    "zh_Hant": {
      "suffix": "Chinese Traditional, 繁體中文",
      "active": false
    },
    "ja": {
      "suffix": "Japanese",
      "active": false
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "i18n": "node updater_i18n",
    "start": "node updater_i18n && run-script-os",
    "start:win32": "chcp 65001 && electron-forge start",
    "start:darwin:linux": "electron-forge start",
    "package": "electron-forge package",
    "make": "node updater_i18n && electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@eslint/compat": "^2.0.3",
    "@reforged/maker-appimage": "^5.2.0",
    "@types/lodash.groupby": "^4.6.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@types/react-virtualized": "^9.21.30",
    "@types/styled-components": "^5.1.36",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitejs/plugin-react": "^6.0.1",
    "app-builder-lib": "^26.8.1",
    "electron": "^41.2.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "node-loader": "^2.1.0",
    "patch-package": "^8.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.8",
    "vite-plugin-static-copy": "^4.0.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@pkmn/sim": "^0.10.7",
    "@xyflow/react": "^12.10.2",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.4",
    "pixi.js": "^8.6.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.2",
    "react-is": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "react-select": "^5.10.2",
    "react-textarea-autosize": "^8.5.9",
    "react-tracked": "^2.0.1",
    "react-virtualized": "^9.22.6",
    "run-script-os": "^1.1.6",
    "styled-components": "^5.3.11",
    "ts-marshal": "^0.0.11",
    "ts-tiled-converter": "^0.0.12",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "com.pokemon.studio",
    "fileAssociations": {
      "ext": "studio",
      "name": "Studio",
      "description": "Pokémon Studio Project file"
    },
    "directories": {
      "output": "out/make"
    },
    "extraResources": [
      "./assets/**"
    ],
    "extraFiles": [
      "psdk-binaries",
      "app-update.yml",
      "placeholder.svg"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Pokémon Studio",
      "artifactName": "Pokemon-Studio-Setup-${version}.${ext}",
      "selectPerMachineByDefault": false
    }
  },
  "volta": {
    "node": "22.17.0"
  }
}
